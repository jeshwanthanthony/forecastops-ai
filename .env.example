# Optional: enables the assistant panel. The forecasting dashboard works without this.
OPENAI_API_KEY=
# Optional. Use a model available to your OpenAI project.
OPENAI_MODEL=gpt-4.1-mini
# A stable random session secret and URL-safe base64-encoded 32-byte AES key.
SESSION_SECRET=
ENCRYPTION_KEY=
# Sandbox credentials only; production is not supported.
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# Alternative local sandbox names (the personal access token is only for testing).
SQUARE_SANDBOX_APP_ID=
SQUARE_SANDBOX_APPLICATION_SECRET=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_REDIRECT_URI=http://localhost:8001/api/square/callback
SQUARE_ENVIRONMENT=sandbox
# Reserved for optional future S3 integration; the app does not create resources.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
