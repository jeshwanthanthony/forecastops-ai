# Local testing: sandbox. AWS public deployment: production.
SQUARE_ENVIRONMENT=sandbox

# Local Square Sandbox developer credentials
SQUARE_SANDBOX_APP_ID=
SQUARE_SANDBOX_APPLICATION_SECRET=
SQUARE_SANDBOX_ACCESS_TOKEN=

# Public OAuth: create Production Application ID and Application Secret
# in the Square Developer Console. Do NOT use a personal Production Access Token.
SQUARE_PRODUCTION_APP_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=

# Must match the redirect URL registered in the corresponding Square environment.
SQUARE_REDIRECT_URI=http://localhost:8001/api/square/callback

# Required for any Square OAuth connection. Stable values across restarts.
SESSION_SECRET=
ENCRYPTION_KEY=

# For HTTPS public hosting set COOKIE_SECURE=true
COOKIE_SECURE=false
PUBLIC_ORIGIN=https://forecastops.jeshwanthanthony.com

# Optional AI analyst. Public demo can run without OpenAI credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional future storage; S3 is not implemented.
AWS_REGION=us-east-2
S3_BUCKET_NAME=
